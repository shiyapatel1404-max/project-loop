{
  "name": "project-loop-backend",
  "version": "1.0.0",
  "description": "Backend API for Project LOOP",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:reset": "knex migrate:rollback --all && knex migrate:latest",
    "seed": "knex seed:run",
    "db:create": "createdb project_loop",
    "db:drop": "dropdb project_loop",
    "build": "tsc"
  },
  "keywords": [
    "feedback",
    "ai",
    "sentiment"
  ],
  "author": "Shiya Patel",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "joi": "^17.11.0",
    "axios": "^1.5.0",
    "winston": "^3.11.0",
    "express-async-errors": "^3.1.1",
    "elasticsearch": "^7.17.0",
    "knex": "^3.0.0",
    "socket.io": "^4.6.0",
    "multer": "^1.4.5-lts.1",
    "csv-parse": "^5.4.1",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0"
  }
}
